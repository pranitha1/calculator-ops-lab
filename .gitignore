# Terraform state — contains REAL secrets (we've seen our own RDS password
# sitting in plaintext in state). Never commit, even to a private repo.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform's local working directory — downloaded provider plugins,
# regenerated automatically by `terraform init`. Do NOT ignore
# .terraform.lock.hcl though (that's a different file, not caught by this
# pattern) — the lock file SHOULD be committed, it pins provider versions
# for reproducibility across machines/pipelines.
**/.terraform/

# Saved plan output files — binary, regenerated by `terraform plan -out=...`,
# not meant for version control.
*.tfplan
tfplan

# Variable files can contain sensitive values depending on what's in them —
# exclude by default as a habit, even though ours don't currently.
*.tfvars
*.tfvars.json

# Private keys/certs anywhere in the project — this project-wide pattern
# exists because a narrower one (scoped to cert-decrypt-practice/ only)
# just missed the REAL private key in v4-asg-alb/key.pem during the dry
# run below. Broad and reliable beats precise and fragile for secrets.
*.pem
*.key
*.pfx

# Scratch JSON files used to pass parameters to one-off SSM commands
# throughout this project — none of our real source lives in .json, so
# excluding the extension entirely is simpler and more robust than trying
# to enumerate every inconsistently-named scratch file individually.
*.json

# Downloaded/generated log samples, not source
*.log.gz

# Scratch plan output
plan-output.txt

# OS noise
Thumbs.db
.DS_Store
